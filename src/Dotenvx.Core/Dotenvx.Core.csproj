<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Dotenvx</RootNamespace>
        <PackageId>Dotenvx.Core</PackageId>
        <Description>Load, parse, get and set .env values (including encrypted ones) from .NET code: Dotenvx.Config(), Get(), Parse() and Set(), a port of the @dotenvx/dotenvx library API.</Description>
        <!-- tracks the dotenvx release this port matches, in lockstep with Dotenvx.csproj -->
        <Version>2.35.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2"/>
        <InternalsVisibleTo Include="Dotenvx"/>
        <InternalsVisibleTo Include="Dotenvx.Configuration.Test"/>
        <InternalsVisibleTo Include="Dotenvx.Core.Test"/>
        <InternalsVisibleTo Include="Dotenvx.Ports.Test"/>
        <InternalsVisibleTo Include="Dotenvx.Test"/>
        <InternalsVisibleTo Include="Dotenvx.ParityTest"/>
    </ItemGroup>

    <!-- Internal ports of npm packages (not separate packages), each tracking the version it was ported from:
         Interop.IgnoreJs = ignore 7.0.5 (^7.0.5 per @dotenvx/tooling), Interop.EnquirerJs = enquirer 2.4.1 (bundled in @dotenvx/tooling),
         Interop.YoctoSpinnerJs = yocto-spinner 1.2.1. -->
    <ItemGroup>
        <ProjectReference Include="..\Dotenvx.Primitives\Dotenvx.Primitives.csproj"/>
        <ProjectReference Include="..\Dotenvx.Providers\Dotenvx.Providers.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2"/>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
    </ItemGroup>

</Project>
