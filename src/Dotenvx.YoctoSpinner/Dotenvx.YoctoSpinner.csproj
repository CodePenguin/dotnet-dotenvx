<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Dotenvx.Interop.YoctoSpinnerJs</RootNamespace>
        <PackageId>Dotenvx.YoctoSpinner</PackageId>
        <Description>The terminal spinner dotenvx shows while it works, ported from the yocto-spinner npm package and drawing the same bytes.</Description>
        <!-- Tracks the exact yocto-spinner npm package version this is ported from (see dotenvx/node_modules/yocto-spinner/package.json). -->
        <Version>1.2.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Dotenvx.Core"/>
        <InternalsVisibleTo Include="Dotenvx.Core.Test"/>
        <InternalsVisibleTo Include="Dotenvx.Test"/>
        <InternalsVisibleTo Include="Dotenvx.ParityTest"/>
    </ItemGroup>

</Project>
