{
 "name": "dotenvx",
 "usage": "dotenvx run -- yourcommand",
 "description": "a secure dotenv–from the creator of `dotenv`",
 "padWidth": 32,
 "arguments": [
  {
   "term": "command",
   "description": "dynamic command"
  },
  {
   "term": "args",
   "description": "dynamic command arguments"
  }
 ],
 "options": [
  {
   "term": "-l, --log-level <level>",
   "description": "set log level (default: \"info\")"
  },
  {
   "term": "-q, --quiet",
   "description": "sets log level to error"
  },
  {
   "term": "-v, --verbose",
   "description": "sets log level to verbose"
  },
  {
   "term": "-d, --debug",
   "description": "sets log level to debug"
  },
  {
   "term": "-V, --version",
   "description": "output the version number"
  },
  {
   "term": "-h, --help",
   "description": "display help for command"
  }
 ],
 "commands": [
  {
   "term": "run [options]",
   "description": "inject env at runtime [dotenvx run -- yourcommand]",
   "name": "run"
  },
  {
   "term": "get [options] [KEY]",
   "description": "return a single environment variable",
   "name": "get"
  },
  {
   "term": "set [options] <KEY> [value]",
   "description": "encrypt a single environment variable",
   "name": "set"
  },
  {
   "term": "del [options] <KEY>",
   "description": "delete a single environment variable",
   "name": "del"
  },
  {
   "term": "encrypt [options]",
   "description": "encrypt .env file(s)",
   "name": "encrypt"
  },
  {
   "term": "decrypt [options]",
   "description": "decrypt .env file(s)",
   "name": "decrypt"
  },
  {
   "term": "keypair [options] [KEY]",
   "description": "print public/private keys for .env file(s)",
   "name": "keypair"
  },
  {
   "term": "ls [options] [directory]",
   "description": "print all .env files in a tree structure",
   "name": "ls"
  },
  {
   "term": "validate [options]",
   "description": "validate .env file(s) against .env.example",
   "name": "validate"
  },
  {
   "term": "gitignore [options]",
   "description": "append to .gitignore",
   "name": "gitignore"
  },
  {
   "term": "genexample [options] [directory]",
   "description": "generate .env.example",
   "name": "genexample"
  },
  {
   "term": "precommit [options] [directory]",
   "description": "prevent committing .env files to code",
   "name": "precommit"
  },
  {
   "term": "prebuild [directory]",
   "description": "prevent including .env files in docker",
   "name": "prebuild"
  },
  {
   "term": "update",
   "description": "update dotenvx",
   "name": "update"
  },
  {
   "term": "help [command]",
   "description": "display help for command",
   "name": "help"
  },
  {
   "term": "ext [command] [args...]",
   "description": "🔌 extensions",
   "name": "ext"
  }
