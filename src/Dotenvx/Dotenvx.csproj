<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- No ICU culture data: the tool never formats for a culture, and an invalid LANG / LC_ALL (LANG=0) otherwise terminates .NET at startup
             with "Argument_CultureNotSupported" on Linux and macOS, where Node ignores it. -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <TargetFramework>net10.0</TargetFramework>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotenvx</ToolCommandName>
        <PackageId>Dotenvx</PackageId>
        <Description>The dotenvx command-line tool for .NET: run any program with its .env files injected, with multiple environments and encrypted .env files. A port of @dotenvx/dotenvx, matching its CLI at the same version.</Description>
        <!-- Tracks the exact upstream dotenvx release this port is pinned to/at parity with (see
             the dotenvx submodule pin and docs/porting-traps.md) - bump this in lockstep with the submodule
             pin, not independently. IncludeSourceRevisionInInformationalVersion false keeps the
             version flag reporting exactly "2.35.0", matching Node's own version output, instead
             of the SDK's default "plus git hash" suffix. -->
        <!-- A fix released for the same upstream version gets a fourth number (2.35.0.1) here and in Dotenvx.Core and
             Dotenvx.Configuration, plus <InformationalVersion>2.35.0</InformationalVersion> so the version flag stays exact
             (CONTRIBUTING.md, "Releasing a fix for the same upstream version"). -->
        <Version>2.35.0.1</Version>
        <InformationalVersion>2.35.0</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Dotenvx</RootNamespace>
        <AssemblyName>dotenvx</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Help/help-spec.json" LogicalName="Dotenvx.Help.help-spec.json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dotenvx.Core\Dotenvx.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0"/>
        <PackageReference Include="System.CommandLine" Version="2.0.0"/>
    </ItemGroup>

</Project>
