<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotenvx</ToolCommandName>
        <PackageId>Dotenvx</PackageId>
        <Authors>David Lambert, @motdotla</Authors>
        <Description>A CLI tool that loads .env files like Node.js @dotenvx/dotenvx.</Description>
        <!-- Tracks the exact upstream dotenvx release this port is pinned to/at parity with (see
             the dotenvx submodule pin and CLAUDE.md) - bump this in lockstep with the submodule
             pin, not independently. IncludeSourceRevisionInInformationalVersion false keeps the
             version flag reporting exactly "2.24.1", matching Node's own version output, instead
             of the SDK's default "plus git hash" suffix. -->
        <Version>2.24.1</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Dotenvx</RootNamespace>
        <AssemblyName>dotenvx</AssemblyName>
        <AssemblyVersion>0.1.51.1</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dotenvx.Core\Dotenvx.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0"/>
        <PackageReference Include="System.CommandLine" Version="2.0.0"/>
    </ItemGroup>

</Project>
