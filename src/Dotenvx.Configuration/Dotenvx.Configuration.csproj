<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Dotenvx.Configuration</PackageId>
        <Description>Adds .env files, encrypted ones included, to Microsoft.Extensions.Configuration with IConfigurationBuilder.AddDotenvx().</Description>
        <!-- tracks the dotenvx release this port matches, in lockstep with Dotenvx.csproj -->
        <Version>2.38.2</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dotenvx.Core\Dotenvx.Core.csproj"/>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.0"/>
    </ItemGroup>

</Project>
