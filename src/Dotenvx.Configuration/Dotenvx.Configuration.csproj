<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Dotenvx.Configuration</PackageId>
        <Description>Adds .env files, encrypted ones included, to Microsoft.Extensions.Configuration with IConfigurationBuilder.UseDotenvx().</Description>
        <!-- tracks the dotenvx release this port matches, in lockstep with Dotenvx.csproj -->
        <Version>2.35.0</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dotenvx.Core\Dotenvx.Core.csproj"/>
    </ItemGroup>

</Project>
