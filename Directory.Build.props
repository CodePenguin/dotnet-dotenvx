<Project>
    <!-- Applies to every project; only the packable ones (Dotenvx, Dotenvx.Primitives, ...) put it in their package.
         The full BSD-3-Clause text with the upstream copyright notice is the LICENSE file at the repository root. -->
    <PropertyGroup>
        <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
